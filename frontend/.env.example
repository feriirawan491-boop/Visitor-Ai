# Safe local demo. Optimized Next production builds still use demo adapters.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_DATA_SOURCE=demo
# Build-time rollback flags; never overridable by query strings or browser storage.
NEXT_PUBLIC_PHASE4_ACCESS_ENABLED=true
NEXT_PUBLIC_PHASE5_ANALYTICS_ENABLED=true
NEXT_PUBLIC_PHASE6_PROVIDER_ENABLED=true
NEXT_PUBLIC_PHASE7_DEFINITIONS_ENABLED=true
# Do not put secrets, RTSP URLs, credentials, tokens or passwords in NEXT_PUBLIC_*.
